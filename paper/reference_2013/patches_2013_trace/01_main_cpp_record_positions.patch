 #include "VX_Object.h"
 #include "VX_Environment.h"
 #include "VX_Sim.h"
+#include <cstdio>
+#include <cstdlib>
+
+// ---- Added for the 2026 reproduction (paper/reference_2013); not part of the 2013 program. ----
+// With the environment variable VX_TRACE set to a file name, the position, rotation and size of
+// every voxel are written to that file every VX_TRACE_EVERY seconds of simulated time (default
+// 0.001). The simulation itself is not touched: its state is only read.
+static void TraceFrame(FILE* f, CVX_Sim& Sim, double Time)
+{
+	Vec3D cm = Sim.GetCM();
+	fprintf(f, "t %.9g %.9g %.9g %.9g\n", Time, (double)cm.x, (double)cm.y, (double)cm.z);
+	int n = Sim.NumVox();
+	for (int i = 0; i < n; i++) {
+		VoxState& s = Sim.VoxArray[i].S;
+		fprintf(f, "%.7g %.7g %.7g %.6g %.6g %.6g %.6g %.6g %.6g %.6g\n",
+			(double)s.Pos.x, (double)s.Pos.y, (double)s.Pos.z,
+			(double)s.Angle.w, (double)s.Angle.x, (double)s.Angle.y, (double)s.Angle.z,
+			(double)s.Scale.x, (double)s.Scale.y, (double)s.Scale.z);
+	}
+}
+// ---- end of the addition ----
+
 
 
 int main(int argc, char *argv[]){
